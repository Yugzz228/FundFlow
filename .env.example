# Copy to .env only if you need to change a default. Nothing here is required for the standard demo.
# This file is for public configuration only. NEVER put a private key or seed phrase in any VITE_
# variable: Vite copies those values into the browser bundle.

# Chain the frontend expects the wallet to be on. Defaults to the chain ID in deployment.json, then 31337.
VITE_CHAIN_ID=31337

# RPC endpoint used for read-only queries, and offered to MetaMask when adding the network.
VITE_RPC_URL=http://127.0.0.1:8545

# Factory address. Leave empty to use frontend/public/deployment.json, written by `npm run deploy`.
VITE_FACTORY_ADDRESS=
